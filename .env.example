VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_DEMO_MODE=true

# Browser auth redirects use the current site origin first.
# Keep APP_URL as a non-browser fallback only.
# Local: http://localhost:5173
# Preview/Production: the active Vercel URL
APP_URL=http://localhost:5173

ROUTE_PROVIDER_MODE=approximate
MAP_PROVIDER=
MAP_PUBLIC_TOKEN=

# Server-only. Never expose this in browser code or Vercel public variables.
SUPABASE_SERVICE_ROLE_KEY=
